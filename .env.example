# ==========================================================
# SMART WASTE MANAGEMENT SYSTEM ENVIRONMENT CONFIGURATION
# ==========================================================

# ----------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ----------------------------------------------------------
# Server Connection Port and Host Address
PORT=8000
HOST=0.0.0.0

# Artificial Intelligence Model Engine Provider (yolo or gemini)
AI_PROVIDER=yolo
YOLO_MODEL_PATH=yolov8n.pt

# Google Gemini Generative AI Key (Get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Realtime Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ----------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ----------------------------------------------------------
# Endpoint Address pointing to the FastAPI backend API
VITE_API_URL=http://localhost:8000

# Mapbox Access Token for Geolocation Map Rendering
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

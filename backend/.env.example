# Server configuration
PORT=8000
HOST=0.0.0.0

# Gemini API Key for waste analysis
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
# Option A: Path to your serviceAccountKey.json file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Option B: Raw JSON string of your serviceAccountKey.json (ideal for production environments like Render/Vercel)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": ...}

# Firebase Storage Bucket name (without the gs:// prefix)
# Example: smart-waste-hyd.appspot.com
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com

# Exclude Git files
.git
.gitignore

# Exclude local configuration files
.env
.env.local
.env.*.local
*.db
compliance_db.json

# Exclude Python build and virtual environment outputs
backend/venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Exclude Frontend build outputs and packages
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local
